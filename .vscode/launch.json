{
  // Launch configurations for running OpenPrism in the devcontainer.
  // Start the data services and API first: `docker compose up -d --wait` (see CLAUDE.md).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OpenPrism: Frontend (Vite)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "apps/frontend", "run", "dev", "--", "--host", "0.0.0.0"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
